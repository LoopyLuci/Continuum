# Continuum Relay Server
FROM rust:1.75-slim-bullseye AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY src/relay-server/Cargo.toml src/relay-server/

RUN cargo fetch

COPY src/relay-server/src src/relay-server/src

RUN cargo build --release -p relay-server

# Runtime
FROM debian:bullseye-slim

RUN apt-get update && apt-get install -y \
    libssl1.1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/relay-server .

EXPOSE 4434
CMD ["./relay-server", "--listen", "0.0.0.0:4434"]
