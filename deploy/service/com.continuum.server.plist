<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Continuum Server — macOS launchd service
  =========================================
  Install:
    cp com.continuum.server.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.continuum.server.plist
    launchctl start com.continuum.server

  Uninstall:
    launchctl stop com.continuum.server
    launchctl unload ~/Library/LaunchAgents/com.continuum.server.plist

  No Docker or Kubernetes required — runs as a native macOS service.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.continuum.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/continuum-server</string>
        <string>--listen</string>
        <string>0.0.0.0:4433</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/usr/local/var/log/continuum-server.log</string>

    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/continuum-server.error.log</string>

    <key>WorkingDirectory</key>
    <string>/usr/local/var/continuum</string>

    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>
