# Continuum Server
FROM rust:1.75-slim-bullseye AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY src/continuum-transport/Cargo.toml src/continuum-transport/
COPY src/continuum-server/Cargo.toml src/continuum-server/
COPY src/continuum-security/Cargo.toml src/continuum-security/
COPY src/continuum-observability/Cargo.toml src/continuum-observability/

RUN cargo fetch

COPY src/continuum-transport/src src/continuum-transport/src
COPY src/continuum-server/src src/continuum-server/src
COPY src/continuum-security/src src/continuum-security/src
COPY src/continuum-observability/src src/continuum-observability/src

RUN cargo build --release -p continuum-server

# Runtime
FROM debian:bullseye-slim

RUN apt-get update && apt-get install -y \
    libssl1.1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/continuum-server .

EXPOSE 4433
CMD ["./continuum-server", "--listen", "0.0.0.0:4433", "--pairing-code", "CHANGE_ME"]
